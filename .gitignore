# File server + Puppeteer server secrets — both .env files hold
# FILE_SERVER_KEY. Must never be committed. .env.example in each folder IS
# committed and shows the expected keys with dummy values.
scripts/file-server/.env
scripts/puppeteer-server/.env

# Microsoft Office lock files — created when a .docx/.xlsx is open in Word/Excel
# on Windows. They're transient and contain the editing user's name.
~$*
