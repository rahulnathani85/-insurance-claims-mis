# ============================================================================
# File Server environment template — copy to `.env` (same folder as server.js)
# and fill in real values. The `.env` file is gitignored; `.env.example` is not.
# ============================================================================

# REQUIRED — 64-character base64 API key. Generate on the VPS with:
#   $b=New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Rotate this every 90 days. Last 4 chars go into the Security State Reference
# in the implementation runbook.
FILE_SERVER_KEY=replace-with-64-char-random-base64-string

# OPTIONAL — public URL the server is reachable on. Only used in response
# payloads (e.g. downloadUrl fields), not for auth. Once Cloudflare Tunnel is
# up, set this to https://files.nisla.in.
FILE_SERVER_URL=http://localhost:4000
