# ============================================================================
# Puppeteer Server environment template — copy to `.env` (same folder as
# server.js) and fill in the real key. The `.env` file is gitignored;
# `.env.example` is not.
# ============================================================================

# REQUIRED — must match the file-server's FILE_SERVER_KEY exactly.
# The Next.js portal forwards a single key to both services, so they must
# agree. Rotate both at the same time.
FILE_SERVER_KEY=replace-with-same-64-char-key-as-file-server
